# P0 的 Renode 檢查：載入 nucleo_f767zi 平台與韌體，跑 0.5 秒虛擬時間，讀出 P0_RESULT。
mach create "p0"
machine LoadPlatformDescription @platforms/boards/nucleo_f767zi.repl
sysbus LoadELF $elf
emulation RunFor "2"
echo "P0_RESULT_BEGIN"
sysbus ReadDoubleWord 0x20000058
sysbus ReadDoubleWord 0x2000005C
sysbus ReadDoubleWord 0x20000060
sysbus ReadDoubleWord 0x20000064
sysbus ReadDoubleWord 0x20000068
sysbus ReadDoubleWord 0x2000006C
echo "P0_RESULT_END"
echo "DWT_CYCCNT"
sysbus ReadDoubleWord 0xE0001004
echo "TIM2_CNT"
sysbus ReadDoubleWord 0x40000024
quit
