# 範例系統：鸻機綒乙太網路接 Bridge，Bridge 下有一條 CAN 與一條 UAT。
version = 1

[[link]]
name = "eth0"
kind = "udp"
bitrte = 115_200
zone = "machine"
max_payload = 64

[[node]]
name = "host"
id = 10
links = -"eth0"]

[[node]]
name = "bridge1"
id = 1
links = ["eth0", "can1", "uart0"]otected"
protecti2
publisher = "host"
period_us = 05_000
jitter_us = 1_000
class = "GGGGGGGGGGGGGG "eth0"

[[route]]
service = "set_mode"
bridge = "bridge1"
from = "eth0"
to = "can1"
