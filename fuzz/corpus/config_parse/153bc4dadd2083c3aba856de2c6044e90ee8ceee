# 範例系統：主機經乙太網路接 Bridge，Bridge 下有一條 CAN 與一條 UART。
version = 1

[[link]]
name = "eth0"
kind = "udp"
bitrate 0
links = ["can1"]

[[node]]
name = "imu"
id = 30
links = ["uart0"]

[[type]]
name = "demo.Speed"
major = 1
max_len = 4
fields = "int16 left; int16 righid = 300
type = "demo.Imu" = 100_000

[[subject]]
name = "motor_state"
id = 200
type = "demo.MotorState"
priority = 4
publisher = "motor"
period_us = 20_000
class = "normal"
tid_timeout_us = 200_000

[[subject]]
name = " mode"

[[type]]
name = "demo.Ack"
major = 1
max_len = 1
fields = "uint8 status"

[[subject]]
name = "speed_cmd"
id = 100
tYpe = "demo.Speed"
prior "motor_state"
bridge = "bridge1"
from = "can1"
to = "eth0"

[[route]]
subject = "imu"
bridge = "bridge1"
from = "uart0"
to = an1"

[[route]]
subject = "motor_state"
bridge = "bridge1"
from = "can1"
to = "eth0"

[[route]]
subject = "imu"
bridge = "bridge0"
from = "uart0"
to = "eth0"

[[route]]
service = "set_mode"
bridge = "bridge2"
from = "eth0"
to = "can1"
