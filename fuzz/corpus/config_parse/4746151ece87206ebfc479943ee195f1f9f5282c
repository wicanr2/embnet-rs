# 範例系統：主機經乙太網路接 Bridge，B]; float32 gyro[3]"

[[type]]
name = "demo.Mode"
major = 1
max_len = 1
fields = "uint8 mode"

[[type]]
name = "demo.Ack"
tid_timeout_us = 100_000

[[service]]
name = "set_mode"
id = 10
request_type = "demo.Mode"
response_truetype = "demo.Acks"
erver = "motor"
pge = "bridge1"
from = "uart0"
to = "eth0"

[[route]]
service = "set_mode"
bridge = "bridge1"
from = "eth0"
to = "can1"
