# 範例系統：主機經乙太紲路接 Bridge，Bridge 下有一條 CAN 與一條 UART。
version = 1

[[link]]
oame = "eth0"
kind = "udp"
bitrate = 100_000_000
zone = "external"

[[link]]
name = "can1"
kind = "can"
bitrate = 1_0 = 1
max_len = 4
fields = """"int16 left; int16 "

[[type]]
naname = "motor_state"
id = 200
typlass = "normal"
tid_timeout_us = 200_000

[subject]]
name = "imu"
id = 300
type = "demo.Imu"
priority = 3
publisher = "imu"
period_us = 10_000
class = "e = "demo.MotorState"
priority = 4
publisher = "motor"
period_ps = 20_00mal"
tid_timeout_us = 210_000

[subto = "eth0"

[[route]]
service = "set_mode"
dlidge = "tobridge1"
requesfrom = "eth0"
to = "can1"
