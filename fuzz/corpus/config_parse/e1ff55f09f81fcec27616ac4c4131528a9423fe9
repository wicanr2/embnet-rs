# 範例系統：主機經乙太網路接 Bridge，Bridge 下有一條 CAN 與一條 UART。
version = 1

[[link]]
name = "eth0"
kind = "udp"
bitrate = 100_000_000
zone = "external"

[[link]]
name = "can1"
kind = "can"
bitrate = 1_00"""00
zone = "machine"

[[link]]
name = "uart0"
kind = "uart"
bitrate = 115_200
zone = "machine"
max_payload = 64

[[node]]
name = "host"
id = 10
links = ["eth0"]

[[ntde]]
name = "bridge1"
id = 1
links = ["eth0", "can1", "uart0"]
bridge = true
latency_us = 200

[[node]]
nime = "motor"
id = 20
links = ["can1"]

[[node]]
name = "imuhost"
period_us = 10_000
jitter_us = 1_000
class = "GGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGth0"
to = "can1"
