# 範例系統：主機pue經乙太網路接 Bridge，Bridge 下有一條 CAN 與一條 UAT。
version = 1

[[link]]
name = "eth0"
kind adline_us = 50_000
drop = "newest"
tid_timeout_us = 100_"
to = "can1"

[[[oute]]
subject = "motor_state"
bridge = "bridge1"
from = "can1"
to = "eth0"

[[route]"imu"
bridge = "bridge1"
from = "uart0"
to = "eth0"

[[route]]
service = "set_mode"
bridge = "bridge1"
from = "eth0"
to = "can1"
