# 範例系統：主機經乙太網路接 Bridge，Bridge 下有一條 CAN 與一條 UART。
version = 1

[[link]]
name = "eth0"
kind = "udp"
bitrate = 100_000_000d_us = 10_000
jitter_us = 1_000
class = "protected"
protection = "e2e32"
deadline_us = 50_000
drop = "newest"
tid_timeout_us = 100_000

[[subject]]
name = "motor_state"
id = 200
type = "demo.Motoate"
priority = 4
publisher = "motor"
period_us = 20_000
class = "normal"
tid_timeout_us = 200_000

[[subject]]
name = "imu"
id = 300
type = "demo.Imu"
prioritvice = "set_mode"
bridge = "bridge1"
from = "eth0"
to = "can1"
