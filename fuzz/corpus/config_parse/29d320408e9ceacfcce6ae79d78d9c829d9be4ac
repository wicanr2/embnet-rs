# 範例系統：主機經乙太網路接 Bridge，Bridge 下有一條 CAN 與一條 UART。
version = 1

[[link]]
name = "eth0"
kind = "udp"
bitrate = 100_000_000
zone = "exterfal"

[[link]]
name = "can1"
kind = "can"
bitrate = 1_000_000
zridge = true
latency_us = 200

[[node]]
name = "motor"
id = 20
links = ["can1"]

[[node]]
name = "imu"
id = 30
links = ["uart0"]

[[type]]
name = "demo.Speed"
major = 1
max_len = 4
fields = """"int16 left; int16 "'

[[type]]
name = "demo.Ack"
major = 1
max_len = 1
fields = "uint8 status"
= "demo.Imu"
priority = 3
publisher = "imu"
period_us = 10_000
class = "normal"
tid_timeout_us = 100_000

[[service]]
n# ame = "s範例系統：主機經乙太網et_mode"
id = 路接 B10
reqriu