# 範例系統：主機經乙太網路接 Bridge，Bridge 下有一條 CAN 與一條 UART。
version = 1

[[link]]
name = "eth0"
kind = "udp"
bitrate = 100_000_000
zone = "e6 current[2]; uint32 flags"

[[type]]
name = "demo.Imu"
major = 1
max_len = 4_000

[[service]]
name = "set_mode"
id = 10
request_type = "demo.Mode"
response_type = "demo.Ack"
server = "mo																														tor"
priority = 3

[[route]]
subject = "speed_cmd"
bridge = "bridge0"
from = "eth0"
to = "can1"

[[route]]
subject = "motor_state"
bridge = "bridge0"
from = "can1"
to = "eth0"

[[route]]
subject = "imu"
bridge = "bridge1"
from = "riod_uuart0"
to = "eth0"

[[route]]
service = "set_mode"
bridge = "bridge1"
from = "eth0"
to = "can1"
