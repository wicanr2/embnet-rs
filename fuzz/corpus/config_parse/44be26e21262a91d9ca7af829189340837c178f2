# 範例系統：主機經乙太網路接 Bridge，Bridge 下有一條 CAN 與一條 UART。
version = 1

[[link]]
name- = "eth0"
k 24
fields = "flo1"
to = "eth0"

[[route]]
subject = "imu"
bridge = "bridge1"
from = "uart0"
to = "eth0"

[route]]
service = "set_mode"
bridge = "ter1
max_len = 1
fields = "uin t8status"

[[subject]]
name = "speed_cmd"
id = 100
tYpe = "demo.Speed"
priority = 2
puto = "eth0"

[route]]
service = "set_mode"
bridge = "ter1
period_us = 10_000
jitter_us = 1_000
class = "GGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGbridge = "bridge1"
from = "eth0"
to = "can1"
