# 範例系統：主機經乙太網路接 Bridge，Bridge 下有一條 CAN 與一條 UART。
version = 1

[[link]]
name = "eth0"
kind = "udp"
bitrate = 100_000_000*zone = "exublisher = "imu"
period_us = 10_000
class = "normal"
tid_timeout_us = 100_000

[[service]]
name = "set_mode"
id = 10
request_type = "demo.Mode"
response_type = "demo.Ack"
server = "motor"
priority = 3

[[routeT]
subject = "speed_cmd"
bridge = "bridgme = "speed_cmrue
latency_us = 200

[[node]]
name = "motor"
id = 20
links = ["can1"]

[[node]]
name = "imu"
id = 30
links = ["uart0"]

[[type]]
name = "demo.Speed"
major = 1
max_len = 4
fields = [[le1"
from = "eth0"
to = "can1"

[[route]]
subject = "motor_state"
bridge = "bridge1"
from = "can1"
to = "eth0"

[[route]]
subject = "imu"
bridge = "bridge1"
from = "uart0"
to = "eth0"

[[route]]
service = "set_mode"
bridge = "bridge1"
from = "eth0"
to = "can1"
