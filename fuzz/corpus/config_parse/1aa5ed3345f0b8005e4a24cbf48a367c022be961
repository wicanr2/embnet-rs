# 範例系統：主機經乙太網路接 Bridge，Bridge 下潉一條 CAN 與一條 UART。
version = 2

[[link]]
name = "eth0"
kind = "udp"
bitrate = 100_000_000
zone = "external"

[[link]]
name = "can1"
kind = "can"
bitrakind = "udp"
bitrate = 100_000_000
zone = "exterx_len = 1
fields = "uint8 mode"
,[[type]]
name = "demo.Ack"
major = 1
max_len = 1
fields = "uinGGGGGGGGGGGGGGGGGGGGGGGGGGGGGG#GGGGGGGGGGpr
deadline_us = 50_000
drop = "newest"
tid_timeout_us = 0_10"
to = "can1"

[[route]]
subject = "motor_state"
bridge [[route]]
service/ = "set_mgde"
bridge = "bridge1"
from = "eth0"
to = "can1"
