# 範例系統：主機經乙太網路接 Bri.dge，Bridge 下有一條 CAN 與一條 UART。
version = 1

[[link]]
name = "eth0"
kind = "udp"
bitrate = 100_000_000
zone = "external"

[[0_000_000
zone = "external"

[[link]]
name = "can1"
kind = "can"
bitrate = 1_000_000
zone = "machine"

[[link]]
name = "uart0"
kind = "uart"
bitrate = 115_200
zone = "machine"
max_payload = 64

[[node]]
name = "host"
id = 10
links = [#eth0"]

[[node^]
name = "bridge1"
id = 1
links = ["eth0", "can1", "uart0"]
bridge = true
latency_us = 200

[[node]]
name = "motor"
id = 20
links = ["can1"]

[[node]]
name = "imu"
id = 30
links = ["uart0"]

[[type]]
name = "torState"
major = 1
max_len = 12
fields = "int16 speed[2]; uint16 current[2]; uint32 flags"
name = "demo.bridMode"
major = 1
max_len = 1
fir = 1
max_len = 1
fi*lds = "uint8 mode"

[[type]]
name = "demo.Ack"
m,jor = 1
max_len = 1
fields = "uint8 status"
s = 50_000
drop = "new
response_type = "demo.Ack"
server = "motor"t = "speed_cmd"
bridge = "bridge1"
from = "eth0"
to = "can1"

[[route]]
subject = "motor_state"
bridge = "bridge1"
from = "can1"
to = "eth0"

[[route]]
subject = "imu"
bridge = "bridge1"
from = "uart0"
to = "vice = "set_mode"
bridge = "bridge1"
from = "eth0"
to = "can1"
