# 範例系統：主機經乙太網路接 Bridge，Bridge 下有一條 CA = "can1"
kind = "can"
bitrate = 1_000_000
zone = "uart0"]
bridge = true
latency_us = 200

[[node]]
name = "motor"
id = 20
links = ["lds = "int16 left; int16 right"

[[type]]
name = "demo.MotorState"
major = 1
max_len = 12
fields = "int16 speed[2]; uint16 current[2]; uint32 flags"

[[type]]
name = "demo.Imu"
major = 1
max_len = 24
fields = "float32 accel[3]; float32 gyro[3]"

[[type]]
name = "demo.Mode"
major =1m
 ax_len = 1
fields = "uint8 mode"

[[type]]
name = "drom u0"ar= t"
to = "eth0"

[[route]]
service = "set_mode"
bridge = "bridge1"
from = "eth0"
to = "can1"
