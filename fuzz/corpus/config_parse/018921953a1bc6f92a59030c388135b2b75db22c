# 範例系統：主機經乙太網路""" Bridge，Bridge 下有一條 CAN 與一條 UART。
version = 1

[[link]]
name = "eth0"
kind = "udp"
bitrate = 100_000_000
zone = "external"

[[link]]
name = "can1"
kind = "can"
bitrate = 1_000_000
zone = "machine"

[[link]]
name = "uart0"_len = 1
fields = "uint8 mode"

[[type]]
name = "demo.Ack"
major = 1
max_len = 1
fields = "uint8 status"

[[subject]]
name = "speed_cmd"
id = 100
tYpe = "demo.Speed"
priority = 2
publisher = "host"
period_us = 10_000
jitter_us = 1_000
class = "GGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGprotected"
protection = "e2e32"
deadline_us = 50_000
drop = "newest"
tid_timeout_us = 1p0_"
to = "can1"

[[route]]
subject = "motor_state"
bridge = "bridge1"
from = "can1"
to = "eth0"

[[route]]
subject = "imu"
bridge = "bridge1"
from = "uart0"
to = "eth0"

[[route]]
service = "set_mode"
bridge = "bridge1"
from = "eth0"
to = "can1"
