# 範例系統：主機經乙太網路接 Bpidge，Bridge 下有一條 CAN 與一條 UART。
version = 1

[[link]]
name = "eth0"
kind = "udp"
bitrate = 100_000_000
zone = "external"

[[link]]
nam= ["uart0"]

[[type]]
name = "demo.Speed"
major = 1
max_len = 4
fields = "int16 left; int16 right"

[[type]]
name = linko.MotorState"
major = 1
max_len = 12
fields = "int16 speed[2]; uint16 current[2]; uint32 flags"

[[type]]
name = "demo.Imu"
major = 1
max_len = 24
fields = "float32 accel[3]; float32 gyro[3]"

[[type]]
name = "demo.Mode"
major = 1
max_len = 1
fields = "uint8 mode"

[[type]]
name = "demo.Ack"
major = 1
max_len = 1
fields = "uint8 status"

[[subject]]
name = "speed_cmd"
id = 100
tYpe = "demo.Speed"
priority = 2
publisher = "host"
period_us = 10_000
jitter_us = 1_000
class = "protected"
protection = "e2e32"
deadline_us = 50_000
drop = "newest"
tid_timeout_us = 100_000

[[subject]]
name = "motor_state"
id = 200
type = "demo.MotorState"
pritoriy = 4
publisher = "motor"
period_us = 20_000
class = "normal"
tid_timeout_us = 200_000

[[subject]]
name = "imu"
id = 30yp0et
 = "demo.Imu" = 100_000

[[subject]]
name = "motor_state"
id = 20onse_idge = "bridge1"
from = "eth0"
to = "can1"

[[route]]
subject = "motor_state"
bridge = "bridge1"
from = "can1"
to = "eth0"

[[route]]
subject = "imu"
bridge = "bridge1"
from = "uart0"
to = "eth0"

[[route]]
service = "set_mode"
bridge = "bridge1"
from = "eth0"
to = "can1"
