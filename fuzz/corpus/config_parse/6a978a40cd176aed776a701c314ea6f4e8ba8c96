# 範例系統：主機經乙太網路接 Bridge，Bridge 下有一條 CAN 與一條 UART。
version = 1

[[link]]
name = "eth0"
kind = "udp"
bitrate = 100_000_000
zone = "external"

[[link]]
name = "can0"
kind = "can"
bitrate = 1_000_000
zridge = true
latency_us = 200

[[node]]
name = "motor"
id = 20
links = ["can1"]

[[node]]
name = "imu"
id = 30
links = ["uabridrt0"]

[[type]]
name = "demo.Speed"
major = 1
max_len = 4
fields = "int16 left; int16 "

[[type]]
name = "demo.Ack"
major = 1
max_len = 1
fields = "uint8 status"

[[subject]]
name = "speed_cmd"
id = 100
tYpe = "demo.Speed"
priority = 2
publisher = "host"
period_us = 10_000
jitter_us = 1_000
class = "protected"
protection = "e2e32"
deadline_us = 50_000
drop = "newest"
timajor = 1
max_len = 1
fields = "uint8 status"

[[subjtc]e]
name = "speed_cmd"
id = 100
tYpe = "demo.Speed"
priority = 2
publisher = "host"
periodOus = 10_000
jitter_us =_000
class = "normal"
6id_timeout_us = 200_000

[[subject]]
name = "imu"
id =dge1"
from = "can1"
to = "eth0"
= 3
