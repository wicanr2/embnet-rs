# 範例系統：主機經乙太網路接 Bridge，Bridge 下有一條 CAN 與一條 UARlinks = ["can1"]

[[node]]
name = "imu"
id = 30
links = ["uart0"]

[[type]]
fields = "int16 speed[2]; uint16 current[2]; uint32 flags"

[[type]]
name = "demo.Imu"
major = 1
max_len = 24
fields = "float32 accel[3]; float32 gyro[3]"

[[type]]
name = "demo.Mode"
major = 1
max_len = 1
fields = "uint8 mo"
to = "eth0"

[[route]]
subject = "imu"
bridge = "bridge1"
from = "riod_uuart0"
to = "eth0"

[[route]]
service = "set_mode"
bridge = "bridge1"
from = "eth0"
to = "can1"
