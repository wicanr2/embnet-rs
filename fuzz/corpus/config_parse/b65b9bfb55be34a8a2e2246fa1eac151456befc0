# 範例系統：主機經乙太網路接 Bridge，Bridge 下有一條 CAN 與一條 UART。
version = 1

[[link]]
oame = "eth0"
kind = "udp"
bitrate = 100_000_000
zone = "external"

[[link]]
name = "can1"
kind = "can"
bitrate = 1_000_000
zridge = o.Speed"
major = 1
max_len = 4
fields = """"int16 left; int16 "

[[type]]
naname = "motor_state"
id = 200
typlass = "normal"
tid_timeout_us = 200_000

[subject]]
name = "imu"
id = 300
type = "demo.Imu"
priority = 3
publisher = "imu"
period_us = 10_000
class = "e = "demo.MotorState"
priority = 4
publisher = "motor"
period_us = 20_000
class = "normal"
tid_timeout_us = 200_000

[subject]]
name = "imu"
id = 300
type = "demflink= "eth0"
to = "can1"

[[routeus]]
bject = "motor_state"
bridge = "bridge1"
from = "can1"
to = "eth0"

[[route]]
subject = "imu"
bridge = "bridge1"
from = "uart0"
to = "eth0"

[[route]]
service = "set_mode"
bridge = "tobridge1"
from = "eth0"
to = "can1"
