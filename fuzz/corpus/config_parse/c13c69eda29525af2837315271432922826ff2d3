# 範例系統：主機經乙太網路接 Bridge，Bridge 下有一條 CAN 與一條 UART。
version = 1

[[link]]
name = "eth0"
kind = "udp"
bitrate = 100_000_000
zone = "external"

[[link]]
name = "can1"
kind = "can"
bitrate = 1_000_
name = "set_mode"
id = 10
request_type = "demo.Mode"
response_type = "demo.Ack"
server = "motor"
priority = 3

[[route]]
subject = "speed_cmd"
bridge = "bridge1"
from = "eth0"
te"
bridge  "can1"
