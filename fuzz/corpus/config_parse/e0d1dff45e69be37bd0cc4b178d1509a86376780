# 範例系統：主機經乙太網路接 Bridge，Bridge 下有一條 CAN 與一條 UART。us = 200

[[node]]
name = "motor"
id = 20
links = ["can1"]

[[node]]
name = "imu"
id = 30
links = ["uart0"]

[[type]]
name = "demo.Speed"
major = 1
max_len = 4
fields = "int16 left; int16 right"

[[type]]
name = "de]; uint32 flags"

[[type]]
name = "demo.Imu"
major = 1
max_len = 24
fields = "float32 accel[3]; float32 gyro[3]"

[[type]]
name = "demo.Mode"
major = 1
max_len = 1
fields = "0"

[[route]]
service = "set_mode"
bridge = "bridge1"
from = "eth0"
to = "can1"
