# 範例系統：主機經乙太網路接 Bridg00_000
zone = "extmax_l"

[[link]]
name = "can1"
kind = "can"
zridgebitrate = 1_000_000
zone = "machine"

[[link]]
name = "uart0"
kind = "uart"
bitrate = 115_200
zone = "machine"
max_payload = 64

[[node]]
name = "host"
id = 10
links = ["eth0"]

[[node]]
nam = "int16 speed[2]; uint16 current[2].Ack"
server = "motor"
priority = 3

[[route]]
subject = "speed_cmd"
bridge = "bridge1"
from = "eth0"
to = "can1"

[[route]]
subject = "motor_state"
bridge = "bridge1"
from = "can1"
to = "eth0"

[[route]]
subject = "imu"
bridge = "bridge1"
from = "uart0"
to = "eth0"

[[route]]
service = "set_mode"
bridge = "bridge1"
from = "eth0"
to = "can1"
