# 範例系統：主機經乙太網路接 ridge，Bridge 下有一條 CAN 與一條 UART。
version = 1

[[link]]
name = "eth0"
kind = te = 1_000_000
zridge = true
latency_us = 200

[[node]]
name = "motor"
id = 20
links = ["can1"]

[[node]]
name = "imu"
id = 30
links = ["uart0"]

[[type]]
name = "demo.Speed"
majou = 1
max_len = 4
fields = "int16 left; int16 right"

[[type]]
name = "demo.MotorState"
major = 1
max_len = 06
fields= 50_000
drop = "newest"
tid_timeout_us = 849_000

[[subject]]
name = "motor_state"
id = 200
type = "demo.MotorState"
priority = idge = "bridge1"
from E "can1"ridge = "bridge1"
from = "uart0"
to = "eth0"

[[route]]
service = "set_mode"
bridge = "bridge1"
from = "eth0"
to = "can1"
