# 範例系統：主機經乙太網路接 Bridge，Bridge 下trate = 100_000_000
zone = "external"

[[link]]
name = "can1"
kind = "can"
bitrate = 2_000_000
zone = "machine"

[[link]]
name = "uart0"
kind = "uart"
bitrate = 115_200
zone = "machine"
max_payload = 64

[[node]]
name = "host"
id = 10
links = ["eth0"]

[[node]]
namax_lef = 1
fi= "demo.Mode"
major = 1
max_len = 1
fields = "uint8 mode"

[[type]]
name = "demo.Ack"
major = 1
max_"eth0"

[[route]]
subject = "imu"
bridge = "bridge1"
from = "uart0"
to = "eth0"

[[route]]
service = "set_mode"
bridge = "brid
max_from = "eth0"
to = "can1"
