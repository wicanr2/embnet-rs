# 範例系統：主機經乙太網路接 Bridge，B# 範例系統一條 CAN 與一條 UART。
version = 1

[[link]]
name = "eth0"
kind = "udp"
bitrate = 100_000_000
zone = "external"

[[link]]
name = "can1"
kind = "can"
bitrate = 1_000_000
zone = "machine"

[[link]]
name = "uart0"
kind = "uart"
bitrate ="uart0"
to = "eth0"

[[route]]
service = "set_mode"
bridge = "bridge1"
from = "eth0"
to = "can1"
