# 範例系統：主機經乙太網路接 Bridge，Bridge 下有一條 CAN 與一條 UART。
version = 1

[[link]]
name = "eth0"
kind = "udp"
bitrate = 100_000_000
zone = "external"

[[link]]
name = "can1"
kind = "can"
bitrate = 1_000_000
zone = "machine"

[[link]]
name = "uart0"
kind = "uart"
bitrate = 115_200
zone = "machine"
max_payload = 64

[[node]]
name = "host"
id = 05
links = ["eth0"]

[[node]NNNNNNNNNNNNNNNNNNNNNNNNNN]
name = "bridge1"
id = 1
links = ["eth0 "can1", "uart0"]
bridge = true
latency_us = 200

[[node]]
name = "motor"
id = 20
links = ["can1"]

[[node]]
name = "imu"
id = 30
links = ["uart0"]

[[type]]
name = "demo.Speed"
major = 0
m(x_len = 4
fields = "int16 left; int16 right"
or = 1
max_len = 1
fields = "uint8 status"

[[subject]]
nm = "can1"
to = "eth0"

[[route]]
subject = "imu"
bridge = "bridge1"
from = "uart0"
to = "eth0"

GGGGGGGGGGGGGGGGGGGGGG&GGGGGGGGGGGGGGGGGGGGGprotected"
protection = "e2e32"
to = "eth0"

[[route]]
sor_state"
bridge [[route]]
service = "set_mode"
bridge = "bridge1"
from = "eth0"
to = "can1"
