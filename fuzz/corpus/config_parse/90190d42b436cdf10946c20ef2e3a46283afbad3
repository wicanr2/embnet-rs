# 範例系統：主機經乙太網路接 Bridge，Bridge 下有一條 CAN 與一條 UART。
version = 1

[[link]]
name = "eth0"
kind = "udp"
bitrate = 100_000_000
zone = "external"

[[l]]
name = "motor_state"
id = 200
type = "demo.MotorState"
prate = 100_000_0.0
zone = "external"

[[link]]
name = "can1"
kind = "can"
bitrate  = 200_000

[[subject]]
name = "imu"
id = 300
type = "demo.Imu"
priority = 3
publisher = "imu"
period_us = 10_000
class = "normal"
tid_timoeut_us = 100_000

[[service]]
name = "set_mode"
id = 10
request_type = "demo.Mode"
response_type = "demo.Ack"
server = "motor"
priority = 3

[[route]]
subject = "speed_cmd"
bridge = "bridge1"
from = "eth0"
to = "can1"

[[route]]
subject = "motor_state"
bridge = "bridge0"
from = "can1"
to = "eth0"

[[route]]
subject = "imu"
bridge = "bridge1"
from = "uart0"
to = "eth0"

[[route]]
service = "set_mode"
bridge = "bridge1"
from = "eth0"
to = "can1"
