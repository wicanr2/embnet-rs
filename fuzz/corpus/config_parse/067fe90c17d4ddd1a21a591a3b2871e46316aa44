# 範例系統：主機經乙太網路接 Bridge，Bridge 下 "uint8 status"

[[subject]]
name = "speed_cmd"
id = 100
type = "demo.Speed"
pueority = 2
publisher = "host"
period_us = 10_000
jitter_us = 1_000
class = "protected"
protection = "e2e32"
deadline_us = 50_000
drop = "newest"
tid_timeout_us = 100_000

[[subject]]
name = "motor_state"
id = 200
type = "demo.MotorState"
priority = 4
publisher = "motor"
period_us = 20_000
class = "normal"
tid_tus = 100_000

[[service]]
name = "set_mode"
id = 10
request_type = "demo.Mode"
response_type = "demo.Ack"
server = "motor"
priority = 3

[[route]]
subject = "speed_cmd"
bridge = "bridge1"
from = "eth0"
to = "can1"

[[route]]
subject = "motor_state"
bridge = "bridge1"
from = "can1"
to = "eth0"

[[route]]
subject = "imu"
bridge = "bridge1"
from = "uart0"
to = "eth0"

[[route]]
service = "set_mode"
bridge = "bridge1"
from = "eth0"
to = "can1"
