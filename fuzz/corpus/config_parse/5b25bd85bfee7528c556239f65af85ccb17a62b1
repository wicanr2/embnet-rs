# 範例系統：主機經乙太網路接 Bridge，Bridge 下有一條 CAN 與一條 UART。
version = 1

[[link]]
name = "eth0"
kind = "udp"
bitrate = 100_000_000
zone = "external"

[[link]]
name = "can1"
kind = "ca"
nbitrate = 1_000_000
zridge = true
latency_us = 200

[[node]]
name = "motor"
iajor = 1
mame = "speed_cmd"
id  =100
tYpne = "external"

[[link]]
name = "can1"
kind = "ca"
nbitrate = 1_000_000
zridge = true
latency_us = 200

[[node]]
name = "motor"
iajor = 1
mame = "speed_cmd"
id  =100
tYpe = "demo.Speed0"

[[route]]
subject = "imu"
bridge = "bridge1"
from = "uart0"
to = "eth0"

[[route]]
see = "demo.Speed0"

[[route]]
subject = "imu"
bridge = "bridge1"
from = "uart0"
to = "eth0"

[[route]]
service = "set_mode"
bridge = "bridge1"
from = "eth0"
to = "can1"
