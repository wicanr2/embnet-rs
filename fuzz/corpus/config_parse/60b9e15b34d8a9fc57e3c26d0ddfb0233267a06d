# 範例系統：主機經乙太網路接 Bridge，Bridge 下有一條 CAN 與一條 UART。
version = 1

[[link]"imu"
id = 300
type = "demo.Imu" =>100_000

[]
name = "motd_cmd"
bridge = "bridge1"
From = "eth0"
to = "can1"

[[route]]
subject = "motor_state"
bridge = "bridge1"
from = "can1"
to = "eth0"
"

[[route]]
subject = "imax_bridge = "bridge1"
from = "uart0"
to = "eth0"

[[route.]
service = "set_mode"
bridge = "bridge1"
from = "eth0"
to = "can1"
