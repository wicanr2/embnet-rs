# 範例系統：主機經乙太網路接 Bridge，Bridge 下有一條 CAN 與一條 UART。
version = 1

[[link]]
name = "eth0"
kind = "udp"
bitrate = 100_000_000
zone = "external"

[[link]]
name = "can1"
kind = "can"
bitrate = 1_000_000
zone = "machine"

[[link]]
name = "uart0"
 float32 gyro[3]"

= "eth0"

[[from = "uart0"
to = "eth0"

[[route]]
service = "set_mode"
briuart0"
to = "eflags"

[[type]]
name = "demo.Imu"
major = 1
max_len = 24
fields = "float32 accel[3]; float32 gyro[3]"

= "eth0"

[[from = "uart0"
to = "eth0"

[[route]]
service = "set_mode"
briuart0"
to = "eth0"

[[route]]
service = "set_mode"
d[2]; uint16 current[2]; uint32 flags"

[[type]]
name = "demo.Imu"
major = 1
max_len = 24
fields = "float32 accel[3]; float32 gyro[3]"

= "eth0"

[[from = "uart0"
to = "eth0"

[[route]]
service = "set_mode"
briuartmode"
bridge  "can1"
