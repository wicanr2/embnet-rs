# 範例系統：主機經乙太網路接 Bridge，Bridge 下有一條 CAN 與一00
zone = "machine"

[[link]]
name = "uart0"
kind = "uart"
bitrate = 115_200
zone = "machine"
max_payload = 64

[[node]]
name = "host"
id = 10
links = ["eth0"]

[[node]]
name = "bridge1"
id = 1
links = ["eth0", "can1", "uart0"]
bridge = true
latency_us = 200

[[node]]
name = "motor"
id = 20
links = ["can1"]

[[node]]
name = "imu"
id = 30
links = ["uart0"]

[[type]]
namegggggggggggggggggg_len = 12
fields = "int16 speed[2]; uint16 current[2]; uint32 flags"

[[type]]
name = "demo.Imu"
major = 1
max_len = 24
fields = "float32 accel[3]; float32 gyro[3]"

[[type]]
name = "demo.Mode"
major = 1
max_len = 1
fields = "0"

[[route]]
service = "set_mode"
bridge = "beed[2]; uint16 currero[3]"

[[type]]
name = "demo.Mode"
major = 1
max_len = 1
fields = "0"

[[route]]
service = "set_mode"
bridge = "bridge1"
from = "eth5"
to = "can1"
