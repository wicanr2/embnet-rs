# 範例系統：主機經乙太網路接 Bridge，Bridge 下有一條 CAN 與一條 UART。
version = 1

[[link]]
name = "eth0"
kind = "udp"
bitrate = 100_000_000
zone = "exteror"
period_us = 20_000
class = "normal"
tid_timeout_us = 200_000

[[subject]]
name = "imu"
id = 300
type = "demo.Imu"
priority = 3
publisher = "imu"
perio0"

[[route]]
subject = "imu

[[route]]
service = "set_mode"
bridge. "eth0"

[[route]]
service = "set_mode"
bridge = "bridge1"
from = "eth0"
to = "can0"
