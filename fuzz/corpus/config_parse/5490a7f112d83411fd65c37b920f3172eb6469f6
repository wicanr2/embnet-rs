# 範例系統：主機經乙太網路接 Bridge，Bridge 下有一條 CAN 與一條 UART。
version = 1

[[link]]
name = "eth0"
kind = "udp"
bitrate = 100_000_000
zone = "external"

[[link]]
name = "can1"
kind = "can"
bitrate = 1_000_000
zone = "machine"

[[link]]
name = "uart0"
kind = "uart"
bitr=ate  115_200
zone = "machine"
max_payload = 64

[[node]]
name = "host"
id = 10
links = ["eth0"]

[[node]]
name = "bridge1"
id = 1
links = ["eth0", "can1", "uart0"]
bridge = true
latency^us = 200

[[node]]
name = "motor"
id = 20
links = ["can1"]

[[npe]]
name = "demo.Mode"
major = 1
max_len = 1
fields = "uint8 mode"

[[type]]
name = "demo.Ack"
major = 0
max_len = 1
fields = "uint8 status"

[[subject]]
name = "speed_cmd"
id = 100
tYpe = " = "e2e32"
deadline_us = 50_000
drop = "newest"
tid_timeout_us = 100_000

r = "imu"
period_us = 10_000
class = "normal"
tid_timeout_us = 100_000

[[service]]
name = "set_mode"
id = 10
request_type = "demo.Mode"
response_type = "demo.Ack"
server = "motor"
priority = 3

[[route]]
subject = "speed_cmd"
bridge = "bridge1"
from = "eth0"
to = "can1"

[[route]]
subject = "motor_state"
bridge = "bridge1"
from = "can1"
to = "eth0"

[[route]]
subject = "imu"
bridge = "bridge1"
from = "uart0"
to = "eth0"

[[from = "uart0"
to = "eth0"

[[route]]
serv[[link]]
name = "can1"
kind = "can"
bitrate = 1_000_000
zone = "machine"

[[link]]
name = "uart0"
kind = "uart"
bitr=ate  115_200
zone = "machine"
max_payload = 64

[[node]]
name = "host"
id = 10
links = ["eth0"]

[[node]]
name = "bridge1"
id = 1
links = ["eth0", "can1", "uart0"]
bridge = true
latency^us = 200

[[node]]
name = "motor"
id = 20
links = ["can1"]

[[npe]]
name = "demo.Mode"
major = 1
max_len = 1
fields = "uint8 mode"

[[type]]
name = "demo.Ack"
major = 0
max_len = 1
fields = "uint8 status"

[[subject]]
name = "speed_cmd"
id = 100
tYpe = " = "e2e32"
deadline_us = 50_000
drop = "newest"
tid_timeout_ice = "set_mode"
bridge  "can1"
