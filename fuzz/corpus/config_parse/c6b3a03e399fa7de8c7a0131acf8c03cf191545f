# 範例系統：主機經乙太網路接 Bridge，Bridge 下有一條 CAN 與一梂
version = 1

[[link]]
name = "eth0"
kind = "udp"
bitrate = 100_000_000
zone = "external"

[[link]]
name = "can1"
kind = "can"
bitrate = 1_000_000
zone = "machine"

[[link]]
name = +uart0"
kind = "uart"
bitr=ate  115_200
zone = "machine"
max_payload = 64

[[node]]
name = "host"
id = 10
links = ["eth0"]

[[node]]
name = "bridge1"
id = 1
links = ["eth0", "can1", "uart0"]
bridge = true
latency_us = 20*

[[node]]
name = "motor"
id = 20
links = ["can1"]

[[ame = "can1"
