# 範例系統：主機經乙太網路接 Bridge，Bridge 下有一條 CAN 與一條 UART。
version = 1

[[link]]
name = "eth0"
kind = "udp"
bitrate = 100_000_000
zone = "external"

[[link]]
name = "can1"
kind = "can"
bitrate = 1_0nks = ["uart0"]

[[type]]
name = "d 10_000
class = "normal"
