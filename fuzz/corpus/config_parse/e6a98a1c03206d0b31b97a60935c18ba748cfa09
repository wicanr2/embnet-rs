# 範例系統：主機經乙太網路接 Bridge，Bridge 下有一條 CAN 與一條 UART。
version = 1

[[link]]
name = "eth0"
kind = "udp"
bitrate = 100_000_000
zone = "external"

[[link]]
name = "can1"
kind = "can"
bitrate = 1_000_000
zridge = true
latency_us = 200

[[node]]
name = "motor"
id = 20
links = ["can1"]

[[node]]
name = "imu"
id = 30
links = ["uart0"]

[[type]]
name = "demo.Speed"
major = 1
max_len = 4
fields = "int16 left; int16 right"

[[type]]
name = "demo.MotorState"
major = 1
max_len = 12
fields = "int16 speed[2]; uint16 current[2]; uint32 flags"

[[type]]
name = "demo.Imu"
major = 1
max_len = 24
fields = "float32 accel[3]; float32 gyro[3]"

[[type]]
name = "demo.Mode"
major = 1
max_len = 1
fields = "uint8 mode"

[[type]]
name = "demo.Ack"
major = 1
max_len = 1
fields = "uint8 status"

[[subject]]
name = ct = "speed_cmd"
bridge = "bridge1"
from = "eth0"
to = "can1"

[[route]]
subject = "motor_state"
bridge = "bridge1"
from = "can1"
to = "eth0"

[[route]]
subject = "imu"
bridge = "bridge1"
from = "uart0"
to = "eth0"

[[route]]
service = "set_mode"
bridge = "bridge1"
from =  status"

[[subject]]
name = ct = "speed_cmd"
bridge = "bridge1"
from = "eth0"
to = "can1"

[[route]]
subject = "motor_state"
bridge = "bridge1"
from = "can1"
to = "eth0"

[[ro"eth0"
to = "can1"
